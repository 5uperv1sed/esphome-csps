# 将本文件复制为 secrets.yaml 并填入你自己的值后再编译。
# secrets.yaml 已被 .gitignore 排除，不会被提交到仓库。
# 注意：所有密钥/密码都不要使用本文件或仓库中出现的任何示例值！

# ---- WiFi ----
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# ---- Home Assistant API 加密密钥（32 字节 base64）----
# 生成方式任选其一：
#   - ESPHome 仪表盘新建设备时会自动生成一段，直接复制
#   - 命令行：openssl rand -base64 32
api_encryption_key: "PASTE-YOUR-OWN-API-KEY-HERE=="

# ---- OTA 升级密码（32 位十六进制）----
# 生成方式：openssl rand -hex 16
ota_password: "PASTE-YOUR-OWN-OTA-PASSWORD-HERE"

# ---- 备用热点密码（至少 8 位）----
ap_password: "change-me-8chars-min"
